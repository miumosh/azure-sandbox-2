# ============================================================================
# リソースグループ
#
# 診断設定そのものはサブスクリプションスコープの拡張リソースなので RG に入らない。
# ここで作る RG は宛先の Log Analytics ワークスペースを置くためだけのもの。
# ============================================================================
resource "azurerm_resource_group" "this" {
  name     = "rg-${local.prefix}-${local.suffix}"
  location = local.location
  tags     = local.tags
}
