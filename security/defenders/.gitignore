# ============================================================================
# このディレクトリ単体でも ignore が効くようにするためのローカル .gitignore
# (リポジトリ直下の .gitignore と重複するが、このディレクトリだけを別リポジトリに
#  切り出した / サブモジュール化した場合でも terraform.tfvars が漏れないようにする)
# ============================================================================

# 実値を書いた tfvars (subscription_id / UPN / 接続元 IP を含む)。sample はテンプレートなので追跡する
terraform.tfvars
*.auto.tfvars
*.tfvars.json
!terraform.tfvars.sample
!*.tfvars.sample
!*.tfvars.example

# プロバイダのローカルキャッシュ
.terraform/
# ロックファイルはバージョン固定のためコミットする
!.terraform.lock.hcl

# ローカル state
# Cosmos DB / Storage のアクセスキーなど機微情報が平文で入るため絶対にコミットしない
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# plan 出力 (state と同様に機微情報を含みうる) / クラッシュログ
*.tfplan
tf.plan
crash.log
crash.*.log

# kubeconfig (az aks get-credentials --file で書き出した場合)
kubeconfig
*.kubeconfig

# 検証スクリプトが吐く実機ログ (実リソース ID / サブスクリプション ID を含む)
out/
